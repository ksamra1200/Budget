{
  "name": "solara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:emulated": "VITE_USE_EMULATORS=true vite",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore --project demo-budget",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-budget \"node tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
